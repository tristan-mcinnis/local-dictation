# Rust build artefacts
/target/

# Downloaded models (multi-GB binaries — fetched via scripts/download-models.sh)
/models/*/
!/models/.gitkeep

# macOS
.DS_Store
._*

# Editor / tooling
.idea/
.vscode/
*.swp
*.swo

# Misc
*.log
dist/

# Release artifacts and credentials. Never commit a Sparkle private key, an
# appcast, a signed archive or a rendered cask: publish.sh uploads them and
# update-cask.sh writes them under dist/ or an untracked tap checkout.
*.dmg
*.p12
*.mobileprovision
ed25519_private.key

# Native Swift helper build artefacts (regenerated by native/cohere-mlx/build.sh)
native/cohere-mlx/.build/

# Synthetic streaming/VAD lab corpora (generated locally, never committed)
testdata/streaming/*.wav
testdata/streaming/*.aiff
testdata/vad/*.wav
testdata/vad/*.aiff
testdata/streaming/
testdata/vad/
testdata/vad-model/

# Python bytecode from release tooling
__pycache__/
*.pyc

# Agent session notes stay local (never published)
.memory/

# Private scrub patterns (client and personal names) for tests/scrub.sh
.scrub-private
